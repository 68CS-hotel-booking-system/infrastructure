# PostgreSQL
POSTGRES_DB=hotel_booking
POSTGRES_USER=hotel_booking
POSTGRES_PASSWORD=

# Khóa JWT riêng của staging
AUTH_JWT_SECRET_BASE64=

# Cấu hình xác minh email
AUTH_VERIFICATION_URL=https://staging.hotelbooking.id.vn/verify-email
AUTH_MAIL_FROM=noreply@hotelbooking.id.vn

# Giá trị này chỉ đủ cho kiểm tra khởi động.
MAIL_HOST=localhost
MAIL_PORT=1025
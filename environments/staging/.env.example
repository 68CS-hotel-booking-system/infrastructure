# PostgreSQL
POSTGRES_DB=hotel_booking
POSTGRES_USER=hotel_booking
POSTGRES_PASSWORD=

# Khóa JWT riêng của staging
AUTH_JWT_SECRET_BASE64=

# Cấu hình xác minh email
AUTH_VERIFICATION_URL=https://staging.hotelbooking.id.vn/verify-email
AUTH_MAIL_FROM=noreply@hotelbooking.id.vn
AUTH_PASSWORD_RESET_URL=https://staging.hotelbooking.id.vn/reset-password

# Giá trị này chỉ đủ cho kiểm tra khởi động.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false

# Gửi thật qua Resend: host=smtp.resend.com, port=587, username=resend,
# password là API key; bật ba cờ auth/STARTTLS và dùng sender đã xác minh.

# Môi trường và Spring profile dùng với compose.app.yaml.
DEPLOY_ENVIRONMENT=production
SPRING_PROFILES_ACTIVE=prod

# Database riêng của production.
POSTGRES_DB=hotel_booking_production
POSTGRES_USER=hotel_booking_production
POSTGRES_PASSWORD=

# Khóa JWT riêng của production.
AUTH_JWT_SECRET_BASE64=

# Link xác minh email trỏ về frontend production.
AUTH_VERIFICATION_URL=https://hotelbooking.id.vn/verify-email
AUTH_MAIL_FROM=noreply@hotelbooking.id.vn

# SMTP mẫu: thay bằng thông tin nhà cung cấp thực tế.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
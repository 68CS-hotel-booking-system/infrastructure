# Môi trường và Spring profile dùng với compose.app.yaml.
DEPLOY_ENVIRONMENT=production
SPRING_PROFILES_ACTIVE=prod

# Database riêng của production.
POSTGRES_DB=hotel_booking_production
POSTGRES_USER=hotel_booking_production
POSTGRES_PASSWORD=

# Khóa JWT riêng của production.
AUTH_JWT_SECRET_BASE64=

# Link xác minh email trỏ về frontend production.
AUTH_VERIFICATION_URL=https://hotelbooking.id.vn/verify-email
AUTH_MAIL_FROM=noreply@notify.hotelbooking.id.vn
AUTH_PASSWORD_RESET_URL=https://hotelbooking.id.vn/reset-password

# SMTP Resend: điền API key vào .env thật, không commit secret.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
